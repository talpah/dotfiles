[push]
	default = simple
	autoSetupRemote = true
	followTags = true

[core]
	editor = vim
	autocrlf = input
	# Shell form so a machine without delta falls back to less instead of erroring
	pager = delta 2>/dev/null || less -FRX
	whitespace = trailing-space,space-before-tab
	untrackedCache = true

[init]
	defaultBranch = main

[pull]
	rebase = false
	ff = only

[fetch]
	prune = true
	prunetags = true
	writeCommitGraph = true

[rebase]
	autoStash = true
	autoSquash = true
	updateRefs = true

[merge]
	conflictStyle = zdiff3

[rerere]
	enabled = true
	autoUpdate = true

[branch]
	sort = -committerdate

[tag]
	sort = version:refname

[column]
	ui = auto

[maintenance]
	auto = true
	strategy = incremental

[diff]
	algorithm = histogram
	colorMoved = default
	colorMovedWS = allow-indentation-change
	wordDiff = color
	renames = copies
	mnemonicPrefix = true

# Structural diffing. Opt in per command: `git dft`, `git dfts`.
[difftool "difftastic"]
	cmd = difft "$LOCAL" "$REMOTE"

[difftool]
	prompt = false

# git-delta: syntax-highlighted pager. Falls back gracefully if delta is
# absent - git just reports the missing pager and pipes to the terminal.
[delta]
	navigate = true
	line-numbers = true
	hyperlinks = true
	side-by-side = false

[interactive]
	diffFilter = delta --color-only 2>/dev/null || cat

[log]
	date = iso

[status]
	showUntrackedFiles = all
	submoduleSummary = true

[help]
	autocorrect = 10

[credential]
	helper = cache --timeout=3600

[transfer]
	fsckobjects = true

[receive]
	fsckObjects = true

[alias]
	# Log aliases
	lg1 = log --graph --abbrev-commit --decorate --date=relative --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(bold yellow)%d%C(reset)' --all
	lg2 = log --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold cyan)%aD%C(reset) %C(bold green)(%ar)%C(reset)%C(bold yellow)%d%C(reset)%n''          %C(white)%s%C(reset) %C(dim white)- %an%C(reset)' --all
	lg = !"git lg1"
	ls = log --pretty=format:"%C(yellow)%h%Cred%d\\ %Creset%s%Cblue\\ [%cn]" --decorate
	ld = log --pretty=format:"%C(yellow)%h\\ %ad%Cred%d\\ %Creset%s%Cblue\\ [%cn]" --decorate --date=relative
	lola = log --graph --decorate --pretty=colorsofgit --abbrev-commit --all
	lol = log --graph --decorate --pretty=colorsofgit --abbrev-commit
	show-incoming = log --pretty=colorsofgit --graph --decorate --boundary --left-right --cherry-pick HEAD...FETCH_HEAD

	# Common shortcuts
	s = status -sb
	st = status
	ci = commit
	cam = commit -am
	co = checkout
	br = branch
	cl = clone
	cp = cherry-pick
	dc = diff --cached

	# Modern git (2.23+)
	sw = switch
	swc = switch -c

	# Utilities
	undo = reset --soft HEAD^
	amend = commit --amend --no-edit
	files = diff-tree --no-commit-id --name-only -r
	aliases = config --get-regexp alias
	stash-all = stash save --include-untracked
	gone = ! git fetch -p && git for-each-ref --format '%(refname:short) %(upstream:track)' refs/heads | awk '$2 == \"[gone]\" {print $1}' | xargs -r git branch -D

	# Worktrees (see the `ccw` shell function)
	wt = worktree
	wtl = worktree list
	wta = worktree add
	wtr = worktree remove

	# Structural diff via difftastic
	dft = -c diff.external=difft diff
	dfts = -c diff.external=difft show

	# Review helpers
	recent = for-each-ref --count=15 --sort=-committerdate refs/heads/ --format='%(refname:short) %(committerdate:relative)'
	staged = diff --cached
	unstage = restore --staged
	discard = restore
	fixup = commit --fixup
	wip = !git add -A && git commit -m 'wip: work in progress --wip--'
	unwip = !git log -1 --pretty=%s | grep -q -- '--wip--' && git reset HEAD~1

[color]
	ui = auto

[color "branch"]
	current = yellow reverse
	local = yellow
	remote = green

[color "diff"]
	meta = yellow bold
	frag = magenta bold
	old = red bold
	new = green bold

[color "status"]
	added = green
	changed = yellow
	untracked = red

[pretty]
	colorsofgit = %Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset
